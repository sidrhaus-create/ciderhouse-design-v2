# Public canonical origin.
NEXT_PUBLIC_SITE_URL=https://ciderhouse.ru

# Production default: enabled. Set false only for an explicit QA session.
NEXT_PUBLIC_ENABLE_AGE_GATE=true

# Optional approved destination for visitors under 18. When empty, the gate
# remains open with a neutral access-restricted message instead of redirecting.
NEXT_PUBLIC_UNDERAGE_DESTINATION=

# Tracking remains disabled until an approved provider and consent model exist.
NEXT_PUBLIC_ANALYTICS_PROVIDER=disabled
